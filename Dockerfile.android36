FROM eclipse-temurin:21-jdk AS jdk
FROM bentech/ionic-capacitor-docker:7@sha256:bbda4420f074d6371a2d0e4362c774a9d54d4d3ba4dad300176eb1020da73be5

USER root
COPY --from=jdk /opt/java/openjdk /opt/java/openjdk
ENV JAVA_HOME=/opt/java/openjdk ANDROID_BUILD_TOOLS_VERSION=35.0.0
ENV PATH="$JAVA_HOME/bin:$ANDROID_SDK_ROOT/build-tools/$ANDROID_BUILD_TOOLS_VERSION:$PATH"

RUN (yes | sdkmanager --licenses >/dev/null) \
    && sdkmanager "platforms;android-36" "build-tools;$ANDROID_BUILD_TOOLS_VERSION"

USER node
